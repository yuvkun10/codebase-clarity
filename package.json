{
  "name": "codebase-clarity",
  "version": "0.1.0",
  "description": "A TypeScript CLI that explains local codebases in plain English.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "codebase-clarity": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run lint && npm test && npm run build && npm run audit:moderate && npm run deps:outdated",
    "audit:moderate": "npm audit --audit-level=moderate",
    "deps:outdated": "npm outdated",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "codebase",
    "architecture",
    "cli",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.7"
  }
}
